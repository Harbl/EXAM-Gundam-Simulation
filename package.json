{
  "name": "gundam-tcg-sim",
  "version": "0.2.0",
  "private": true,
  "description": "Windows desktop app that simulates batches of Gundam Card Game matches between two pasted decklists.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "sim": "node bin/simulate.js",
    "images": "node bin/download-images.js",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.jake.exam",
    "productName": "EXAM",
    "icon": "build/icon.png",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "data/**/*",
      "bin/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "Harbl",
      "repo": "EXAM-Gundam-Simulation"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "electron-updater": "^6.8.9"
  }
}
